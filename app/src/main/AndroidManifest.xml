<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strictly ZERO uses-permission tags. 100% offline via Storage Access Framework -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">

            <!-- Launcher Filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 1. VIEW Intent Filter for content:// scheme with explicit MIME types -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/x-rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/css" />
                <data android:mimeType="text/javascript" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>

            <!-- 2. VIEW Intent Filter for file:// scheme with explicit MIME types -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <!-- 3. Fallback VIEW Filter for generic octet-stream and code file extensions.
                 Note: pathPattern matching works for file:// and some direct content providers,
                 but content:// URIs with opaque document IDs (e.g., DocumentProvider) usually do not
                 contain the filename in the URI path. FileRouter handles runtime sniffing for those. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.py" />
                <data android:pathPattern=".*\\.java" />
                <data android:pathPattern=".*\\.kt" />
                <data android:pathPattern=".*\\.kts" />
                <data android:pathPattern=".*\\.cpp" />
                <data android:pathPattern=".*\\.c" />
                <data android:pathPattern=".*\\.h" />
                <data android:pathPattern=".*\\.hpp" />
                <data android:pathPattern=".*\\.js" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\.css" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>

        </activity>
    </application>

</manifest>
